    "test": "vitest run"
  },
  "dependencies": {
    "@da/domain": "workspace:*",
    "i18next": "^25.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
