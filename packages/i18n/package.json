{
  "name": "@da/i18n",
  "version": "1.0.0",
  "private": true,
  "description": "Localization for Dijital Asistan — Turkish (default) and English, plus locale-aware date/number formatting.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
