# Caddy in front of the web container. Certificates come from Let's Encrypt automatically
# (the .app TLD is HSTS-preloaded, so HTTPS is mandatory anyway). Keep the DNS records
# "DNS only" in Cloudflare until the first certificate is issued.
{
	email {$ACME_EMAIL}
}

{$SITE_HOST} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}
	reverse_proxy web:3000
}

www.{$SITE_HOST} {
	redir https://{$SITE_HOST}{uri} permanent
}
