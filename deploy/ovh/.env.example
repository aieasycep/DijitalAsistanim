# Copy to deploy/ovh/.env on the server. Read by docker compose (image tag, Caddy) and passed to the web
# container. NEXT_PUBLIC_* values are inlined at build time and are set as repository variables for
# .github/workflows/web-image.yml instead.

# Image tag published by the "Web image" workflow: latest (main) or sha-<7 chars>
WEB_IMAGE_TAG=latest
# Let's Encrypt account e-mail (expiry notices)
ACME_EMAIL=destek@dijitalasistan.app
SITE_HOST=dijitalasistan.app

# Contact addresses used by the footer, support page and legal page headers. The legal texts themselves name
# the default addresses, so keep these unless the copy in apps/web/src/i18n is changed too.
SUPPORT_EMAIL=destek@dijitalasistan.app
PRIVACY_EMAIL=gizlilik@dijitalasistan.app

# Universal / App Links files (served dynamically by /.well-known/*)
IOS_BUNDLE_ID=com.dijitalasistan.app
ANDROID_PACKAGE=com.dijitalasistan.app
# Apple Developer Team ID (10 characters) — leave empty until the iOS build exists
APPLE_TEAM_ID=
# Comma-separated SHA-256 fingerprints of the Android signing certificate(s) (from `eas credentials`)
ANDROID_SHA256_CERT_FINGERPRINTS=
