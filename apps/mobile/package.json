{
  "name": "@da/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild --no-install",
    "prebuild:clean": "expo prebuild --no-install --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --ci --passWithNoTests",
    "test:watch": "jest --watch",
    "validate": "node scripts/validate-expo.mjs",
    "doctor": "expo-doctor",
    "e2e": "maestro test maestro/flows",
    "e2e:ios": "maestro test --platform ios maestro/flows",
    "e2e:android": "maestro test --platform android maestro/flows",
    "build:ios:dev": "eas build --profile development --platform ios",
    "build:android:dev": "eas build --profile development --platform android",
    "build:production": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@da/api-client": "workspace:*",
    "@da/design-tokens": "workspace:*",
    "@da/domain": "workspace:*",
    "@da/i18n": "workspace:*",
    "@da/ui": "workspace:*",
    "@da/validation": "workspace:*",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo/ui": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.115.0",
    "@tanstack/react-query": "^5.102.0",
    "expo": "~57.0.20",
    "expo-apple-authentication": "~57.0.1",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.4",
    "expo-auth-session": "~57.0.11",
    "expo-background-task": "~57.0.16",
    "expo-build-properties": "~57.0.17",
    "expo-calendar": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.17",
    "expo-contacts": "~57.0.4",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-linking": "~57.0.9",
    "expo-localization": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.19",
    "expo-secure-store": "~57.0.3",
    "expo-share-intent": "^8.0.1",
    "expo-sharing": "~57.0.18",
    "expo-speech": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.16",
    "expo-web-browser": "~57.0.2",
    "expo-widgets": "~57.0.17",
    "i18next": "^25.5.0",
    "posthog-react-native": "^4.67.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "^16.0.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-purchases": "^9.7.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "expo-doctor": "^1.20.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": ["<rootDir>/jest.setup.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|expo-share-intent|posthog-react-native|@shopify/flash-list|react-native-mmkv|react-native-purchases)"
    ],
    "moduleNameMapper": {
      "^@da/(.*)$": "<rootDir>/../../packages/$1/src"
    },
    "testPathIgnorePatterns": ["/node_modules/", "/ios/", "/android/", "/.expo/"]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
