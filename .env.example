# =============================================================================
# Dijital Asistan — environment template
# Copy to `.env` (root), `apps/mobile/.env`, `apps/web/.env.local` and
# `supabase/.env.local` as needed. NEVER commit real values.
#
# Variable prefixes:
#   EXPO_PUBLIC_*   → bundled into the mobile app (public, never secrets)
#   NEXT_PUBLIC_*   → bundled into the website (public, never secrets)
#   everything else → server-side only (Supabase Edge Functions / CI)
# =============================================================================

# ----------------------------------------------------------------------------
# App identity / URLs
# ----------------------------------------------------------------------------
APP_NAME="Dijital Asistan"
APP_SCHEME=dijitalasistan
IOS_BUNDLE_ID=com.dijitalasistan.app
ANDROID_PACKAGE=com.dijitalasistan.app
IOS_APP_GROUP=group.com.dijitalasistan.app
APPLE_TEAM_ID=
WEB_URL=https://dijitalasistan.app
EXPO_PUBLIC_WEB_URL=https://dijitalasistan.app
NEXT_PUBLIC_WEB_URL=https://dijitalasistan.app
EXPO_PUBLIC_APP_SCHEME=dijitalasistan
# App / Universal / App Links hosts (comma separated)
EXPO_PUBLIC_UNIVERSAL_LINK_HOSTS=dijitalasistan.app,www.dijitalasistan.app

# ----------------------------------------------------------------------------
# Demo / local mode (development only — disabled automatically in production builds)
#   demo   → deterministic in-app fixtures, no backend required
#   supabase → real Supabase backend
# ----------------------------------------------------------------------------
EXPO_PUBLIC_DATA_MODE=demo
EXPO_PUBLIC_DEMO_USER_NAME=Yunus
# E2E (Maestro) builds: pin the demo clock/timezone so greetings and seeded meetings are deterministic
#EXPO_PUBLIC_DEMO_NOW=2026-09-05T06:41:00Z
#EXPO_PUBLIC_DEMO_TIMEZONE=Europe/Istanbul

# ----------------------------------------------------------------------------
# Supabase
# ----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Superuser connection used by `pnpm validate:migrations` / `pnpm test:db` (Supabase CLI local stack: port 54322)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Secret used by pg_cron → Edge Function calls and internal function-to-function calls
INTERNAL_FUNCTION_SECRET=

# ----------------------------------------------------------------------------
# Encryption (OAuth refresh tokens at rest — AES-256-GCM)
#   32 random bytes, base64. Generate: `openssl rand -base64 32`
#   Rotate with TOKEN_ENCRYPTION_KEY_PREVIOUS (old key kept until re-encryption finishes)
# ----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# ----------------------------------------------------------------------------
# Google OAuth (Gmail, Google Calendar, Google Tasks, Sign-in)
# ----------------------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect registered in Google Cloud Console → points at the Edge Function
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR-PROJECT.supabase.co/functions/v1/oauth-google-callback
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Gmail push (optional) — Pub/Sub topic; without it polling fallback is used
GOOGLE_PUBSUB_TOPIC=
GOOGLE_PUBSUB_VERIFICATION_TOKEN=

# ----------------------------------------------------------------------------
# Microsoft OAuth (Outlook Mail, Calendar, To Do, Sign-in)
# ----------------------------------------------------------------------------
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
MICROSOFT_OAUTH_REDIRECT_URI=https://YOUR-PROJECT.supabase.co/functions/v1/oauth-microsoft-callback
# Graph change notifications (optional) — without it polling fallback is used
MICROSOFT_GRAPH_WEBHOOK_URL=
MICROSOFT_GRAPH_WEBHOOK_CLIENT_STATE=

# ----------------------------------------------------------------------------
# Apple Sign in (Supabase Auth provider configuration — supabase/config.toml reads
# APPLE_SERVICES_ID + APPLE_OAUTH_CLIENT_SECRET). The client secret is a JWT you generate from the
# Sign in with Apple key: APPLE_KEY_ID + the .p8 file (kept here only as the inputs of that step).
# ----------------------------------------------------------------------------
APPLE_SERVICES_ID=
APPLE_OAUTH_CLIENT_SECRET=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_P8_BASE64=

# ----------------------------------------------------------------------------
# AI providers (server-side only)
#   AI_PROVIDER: anthropic | openai
#   AI_FALLBACK_PROVIDER: optional second provider
# ----------------------------------------------------------------------------
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SMALL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_LARGE=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-5-mini
OPENAI_MODEL_LARGE=gpt-5
# Token / cost guardrails
AI_MAX_INPUT_TOKENS_PER_CALL=12000
AI_DAILY_TOKEN_BUDGET_FREE=60000
AI_DAILY_TOKEN_BUDGET_PRO=1500000

# ----------------------------------------------------------------------------
# Embeddings (optional — without it PostgreSQL full-text search is used)
#   EMBEDDING_PROVIDER: openai | voyage | none
# ----------------------------------------------------------------------------
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VOYAGE_API_KEY=

# ----------------------------------------------------------------------------
# Speech (optional — device TTS/STT are used when absent)
#   TTS_PROVIDER: none | openai | elevenlabs
#   STT_PROVIDER: none | openai | deepgram
# ----------------------------------------------------------------------------
TTS_PROVIDER=none
TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
STT_PROVIDER=none
DEEPGRAM_API_KEY=

# ----------------------------------------------------------------------------
# RevenueCat (subscriptions)
# ----------------------------------------------------------------------------
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_SECRET_API_KEY=
EXPO_PUBLIC_RC_ENTITLEMENT_ID=pro
EXPO_PUBLIC_RC_PRODUCT_MONTHLY=da_pro_monthly
EXPO_PUBLIC_RC_PRODUCT_ANNUAL=da_pro_annual

# ----------------------------------------------------------------------------
# Push notifications (Expo Push)
#   TIME_SENSITIVE_ENTITLEMENT: set to true only after Apple approves the
#   com.apple.developer.usernotifications.time-sensitive entitlement; the server
#   then sends deadline/meeting pushes with interruptionLevel "time-sensitive".
# ----------------------------------------------------------------------------
EXPO_ACCESS_TOKEN=
EXPO_PUBLIC_EAS_PROJECT_ID=
TIME_SENSITIVE_ENTITLEMENT=false

# ----------------------------------------------------------------------------
# Error monitoring (Sentry) — optional; no-op when absent
# ----------------------------------------------------------------------------
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ----------------------------------------------------------------------------
# Product analytics (PostHog) — optional; no-op when absent
#   Server-side events use POSTHOG_KEY / POSTHOG_HOST (fall back to the EXPO_PUBLIC_ values)
# ----------------------------------------------------------------------------
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# ----------------------------------------------------------------------------
# Maps / routes (optional — travel time is only shown when configured)
#   ROUTES_PROVIDER: none | google
# ----------------------------------------------------------------------------
ROUTES_PROVIDER=none
GOOGLE_ROUTES_API_KEY=

# ----------------------------------------------------------------------------
# Cron secret (pg_cron → Edge Function calls; INTERNAL_FUNCTION_SECRET takes precedence)
# ----------------------------------------------------------------------------
CRON_SECRET=

# ----------------------------------------------------------------------------
# Support / legal
# ----------------------------------------------------------------------------
SUPPORT_EMAIL=destek@dijitalasistan.app
PRIVACY_EMAIL=gizlilik@dijitalasistan.app

# ----------------------------------------------------------------------------
# Web (apps/web) — store badges and App/Universal Link association files
#   Leave the store URLs empty until the listings are live; the site then shows the beta path.
#   ANDROID_SHA256_CERT_FINGERPRINTS: comma-separated SHA-256 signing cert fingerprints (AA:BB:...)
# ----------------------------------------------------------------------------
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
ANDROID_SHA256_CERT_FINGERPRINTS=
# Free-trial length advertised on the website — leave empty unless the store products carry a free
# introductory offer of exactly this length (the app itself always reads the trial from the store).
NEXT_PUBLIC_TRIAL_DAYS=
