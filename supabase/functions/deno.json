{
  "unstable": [
    "sloppy-imports"
  ],
  "compilerOptions": {
    "strict": true,
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@da/domain": "../../packages/domain/src/index.ts",
    "@da/validation": "../../packages/validation/src/index.ts",
    "@da/server-core": "../../packages/server-core/src/index.ts",
    "@da/server-core/": "../../packages/server-core/src/",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.115.0",
    "zod": "npm:zod@4.5.4",
    "i18next": "npm:i18next@25.5.0"
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any",
        "no-sloppy-imports"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true
  }
}
